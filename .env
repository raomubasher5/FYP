# Automatrix Server Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# MongoDB
# Local (start with `npm run dev:mongo`):  mongodb://127.0.0.1:27017/automatrix
# Atlas:                                   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/automatrix
MONGO_URI=mongodb://127.0.0.1:27017/automatrix

# AI Engine Configuration
# Supported Providers: mock | gemini | groq | contextual
AI_PROVIDER=mock
AI_MODEL=mock-model

# Optional API Keys (when switching provider from 'mock'/'contextual')
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Scheduler
SCHEDULER_INTERVAL_MS=4000

# Ollama (local models on your PC — no API key, no internet needed)
# Start:  ollama serve   ·   Pull a model:  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============================================================
# LIVE PLATFORM PUBLISHING (optional — leave empty for sandbox)
# The app works in sandbox mode without any of these.
# Set them to enable REAL publishing via OAuth (Channels page).
# ============================================================
# X (Twitter) — free app at developer.twitter.com
#   callback: http://localhost:3000/api/auth/callback/twitter
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta (Facebook Page + Instagram Business) — app at developers.facebook.com
#   redirect: http://localhost:3000/api/auth/callback/facebook
META_APP_ID=
META_APP_SECRET=

# TikTok — client at developers.tiktok.com (needs Direct Post capability)
#   redirect: http://localhost:3000/api/auth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Public URL of the Express server (OAuth callbacks must reach it)
PUBLIC_URL=http://localhost:3000
