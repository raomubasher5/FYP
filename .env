# Automatrix Server Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# AI Engine Configuration
# Supported Providers: mock | gemini | groq | openai
AI_PROVIDER=mock
AI_MODEL=mock-model

# Optional API Keys (when switching provider from 'mock')
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Scheduler
SCHEDULER_INTERVAL_MS=4000
